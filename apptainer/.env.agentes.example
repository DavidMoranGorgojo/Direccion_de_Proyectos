# Copiar a ~/.config/arsoft/agentes.env (sin subir secretos a Git).
# Usa el mismo token que en el entorno local del Backend.
ARSOFT_SERVICE_TOKEN=
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:14b
USE_REAL_AGENT2=1
AGENT2_BACKEND_BASE_URL=http://127.0.0.1:8000
ARSOFT_ENV=production
HF_HOME=/models/huggingface
