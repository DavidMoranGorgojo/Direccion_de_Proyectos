
Bootstrap: docker
From: python:3.12-slim

%labels
    Project ARSOFT
    Service Frontend-PySide6

%files
    Frontend /opt/arsoft/frontend

%post
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libdbus-1-3 \
        libfontconfig1 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-shape0 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-xinerama0 \
        libxcb-xfixes0 \
        libx11-xcb1 && \
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir \
        -r /opt/arsoft/frontend/requirements.txt

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/opt/arsoft/frontend
    export QT_QPA_PLATFORM=xcb

%runscript
    cd /opt/arsoft/frontend
    exec python main.py
