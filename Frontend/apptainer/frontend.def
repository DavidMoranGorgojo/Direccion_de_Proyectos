Bootstrap: docker
From: python@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

%labels
    Project ARSOFT
    Service Frontend-PySide6

%help
    Frontend PySide6 de ARSOFT.
    Ejecutar:  apptainer run --cleanenv frontend.sif   (necesita DISPLAY; ver apptainer/run-frontend.sh)
    Modo simulado (demo) sin ARSOFT_API_URL; modo real con ARSOFT_API_URL=https://... (ver Frontend/readme.md).

%files
    Frontend /opt/arsoft/frontend

%post
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libdbus-1-3 \
        libfontconfig1 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-shape0 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-xinerama0 \
        libxcb-xfixes0 \
        libx11-xcb1 && \
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir \
        -r /opt/arsoft/frontend/requirements.txt

    # Fuera de la imagen: cachés de Python, ajustes de editor, secretos y plantillas locales.
    find /opt/arsoft/frontend -name '__pycache__' -type d -prune -exec rm -rf {} +
    rm -rf /opt/arsoft/frontend/.vscode /opt/arsoft/frontend/.env /opt/arsoft/frontend/apptainer

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/opt/arsoft/frontend
    export QT_QPA_PLATFORM=xcb

%runscript
    cd /opt/arsoft/frontend
    exec python main.py

%test
    # Se ejecuta al final de la construcción: falla el build si la imagen no arranca.
    cd /opt/arsoft/frontend
    QT_QPA_PLATFORM=offscreen python -c "import PySide6.QtWidgets, config, services.api as api; print('Frontend OK, modo simulado:', api.is_mock())"
