# Copiar a .env.local y editar como archivo de configuración Bash.
POSTGRES_USER=arsoft
POSTGRES_DB=arsoft
POSTGRES_PASSWORD=CAMBIAR_ANTES_DE_USAR
# Los scripts construyen DATABASE_URL con estas credenciales.
AGENTES_URL=http://127.0.0.1:8001
# Usa el mismo secreto aleatorio en Backend y Agentes.
ARSOFT_SERVICE_TOKEN=
# Opcional: clave para firmar las sesiones de login (CTR-005). Si se deja vacía se deriva de ARSOFT_SERVICE_TOKEN.
ARSOFT_JWT_SECRET=
