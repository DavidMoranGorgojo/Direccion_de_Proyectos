# Plantilla de configuración. Copia este archivo como `.env` (en la raíz o en Frontend/)
# y edita los valores. Los archivos .env reales NO se suben a git.

# =============================================================================
# Frontend
# =============================================================================
# Se lee en Frontend/config.py. Prioridad: variables de entorno del sistema >
# Frontend/.env > .env de la raíz > valores por defecto.
# Detalle en Frontend/readme.md.

# Modo de funcionamiento:
#   simulado -> respuestas de prueba, sin Backend (para desarrollar la interfaz)
#   real     -> llamadas HTTP al Backend en ARSOFT_API_URL
#   (vacío)  -> automático: real si hay ARSOFT_API_URL, simulado si no
ARSOFT_MODO=simulado

# URL base del Backend, sin barra final. Obligatoria en modo real.
# Fuera de localhost/127.0.0.1/*.local debe ser https://
ARSOFT_API_URL=

# Rutas del Backend (se añaden a ARSOFT_API_URL).
ARSOFT_LOGIN_PATH=/auth/login
ARSOFT_HISTORIAL_PATH=/chats
# Pendiente de confirmar con Backend (actualmente expone POST /consulta).
ARSOFT_CONSULTA_PATH=/agentes/consulta

# Tiempo máximo de espera de cada petición, en segundos.
ARSOFT_TIMEOUT_S=60

# Solo para pruebas: permitir http:// hacia servidores no locales (1 = sí).
ARSOFT_ALLOW_HTTP=0

# Solo en modo simulado: arrancar con el historial vacío (1 = sí).
ARSOFT_MOCK_EMPTY_HISTORY=0
