# Plantilla para uso manual. start-all.sh genera credenciales si el archivo no existe.
# Solo desarrollo local. Nunca uses las cuentas de prueba en producción.
POSTGRES_USER=arsoft
POSTGRES_DB=arsoft
POSTGRES_PASSWORD=CAMBIAR_ANTES_DE_USAR
AGENTES_URL=http://127.0.0.1:8001
ARSOFT_SERVICE_TOKEN=
ARSOFT_JWT_SECRET=
ARSOFT_SEED_DEV_USERS=1
ARSOFT_INGESTA=auto
ARSOFT_AGENT_TIMEOUT_SECONDS=210
